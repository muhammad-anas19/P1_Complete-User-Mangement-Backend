# Copy this file to .env and fill in real values. .env is git-ignored; this
# file is committed as documentation of what keys the app expects — see
# docs/qa/phase-1-scaffold-db-understanding-check.md Q4.

NODE_ENV=development
PORT=3001

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_NAME=p1_dashboard_dev

# Generate real values, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be 32+ characters — a short secret is brute-forceable.
JWT_ACCESS_SECRET=replace-with-a-real-32-char-minimum-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-char-minimum-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Exact frontend origin — never a wildcard, since cookies require
# credentials:true, which is incompatible with Access-Control-Allow-Origin: *
CORS_ORIGIN=http://localhost:3000
